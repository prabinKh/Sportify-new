# =============================================================
# Local Network IP Configuration
# Set this to your machine's LAN IP (run 'ipconfig getifaddr en0' on macOS)
# or run './start_lan.sh' (or 'npm run lan') to auto-detect automatically.
# =============================================================
LOCAL_IP=192.168.1.63
VITE_LOCAL_IP=192.168.1.63

# URLs (read by frontend, backend, and Spotify OAuth)
VITE_API_BASE_URL=http://192.168.1.63:8000
VITE_SPOTIFY_REDIRECT_URL=http://192.168.1.63:3000

# Spotify Client ID (optional, if using Spotify Web API)
VITE_SPOTIFY_CLIENT_ID=
