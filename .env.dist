# =============================================================
# Sportify Environment Configuration (.env)
# =============================================================

# Backend API Base URL (local dev: http://127.0.0.1:8000)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Local Machine / LAN IP settings (Auto-updated by ./start_lan.sh)
LOCAL_IP=127.0.0.1
VITE_LOCAL_IP=127.0.0.1

# Spotify OAuth Redirect URL
VITE_SPOTIFY_REDIRECT_URL=http://127.0.0.1:3000

# Spotify Client ID (optional, if using Spotify Web API)
VITE_SPOTIFY_CLIENT_ID=
